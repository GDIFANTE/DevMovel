<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Cabeçalho superior. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@color/ergo_navy"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <!-- Logo do ErgoPeritus. -->
        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/bg_logo" />

        <!-- Nome e descrição do aplicativo. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:text="@string/hub_app_description"
                android:textColor="@color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Botão de usuário. -->
        <ImageButton
            android:id="@+id/btnUsuario"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_user_button"
            android:contentDescription="@string/user_button_description"
            android:padding="10dp"
            android:src="@drawable/ic_person" />

    </LinearLayout>

    <!-- Conteúdo principal do HUB. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="30dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Título da área de ações. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hub_question"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/hub_instruction"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Nova avaliação: ação principal. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovaAvaliacao"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="30dp"
                android:text="@string/new_evaluation_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ergo_navy"
                app:cornerRadius="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/new_evaluation_description"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Continuar avaliação. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarAvaliacao"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:text="@string/continue_evaluation_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ergo_purple"
                app:cornerRadius="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/continue_evaluation_description"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Histórico. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorico"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:text="@string/history_button"
                android:textAllCaps="false"
                android:textColor="@color/ergo_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/field_background"
                app:cornerRadius="9dp"
                app:strokeColor="@color/field_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/history_description"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Área de última atividade. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/last_activity_title"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Card provisório, enquanto não existe banco de dados. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="9dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/field_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_activity_title"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/no_activity_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>